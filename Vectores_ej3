float numeros[] = {5.4, 5.39, 5.38, 5.31, 5.21, 5.03, 4.45, 3.95, 2.6, 1.49};
float mayor;
int cantidad = 10;

void setup()
{
  Serial.begin(9600);

  mayor = numeros[0];
  for (int i = 1; i < cantidad; i++)
  {
    if (numeros[i] > mayor)
    {
      mayor = numeros[i];
    }
  }
}

void loop()
{
  Serial.print("El numero mas grande es: ");
  Serial.println(mayor);
}
