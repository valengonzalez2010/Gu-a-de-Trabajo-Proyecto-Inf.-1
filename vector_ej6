int numeros[] = {2, 6, 10, 11};
int cantidad = 4;

void setup()
{
  Serial.begin(9600);
}

void loop()
{
  for (int i = 0; i < cantidad; i++)
  {
    Serial.print("Multiplos de ");
    Serial.print(numeros[i]);
    Serial.print(": ");
    for (int m = 1; m <= 5; m++)
    {
      Serial.print(numeros[i] * m);
      Serial.print(" ");
    }
    Serial.println();
  }
}
