int led = 8;
int boton = 2;
int secuencia[5];
int cantidad = 5;

void setup()
{
  pinMode(led, OUTPUT);
  pinMode(boton, INPUT);
  Serial.begin(9600);
}

void loop()
{
  for (int i = 0; i < cantidad; i++)
  {
    digitalWrite(led, HIGH);
    delay(1500);
    secuencia[i] = digitalRead(boton);
    digitalWrite(led, LOW);
    delay(500);
  }

  Serial.print("Secuencia: ");
  for (int i = 0; i < cantidad; i++)
  {
    Serial.print(secuencia[i]);
    Serial.print(" ");
  }
  Serial.println();

  for (int i = 0; i < cantidad; i++)
  {
    secuencia[i] = 0;
  }
  delay(2000);
}
