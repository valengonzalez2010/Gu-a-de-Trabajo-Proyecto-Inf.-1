int buzzer = 8;
int numeros[10];
int cantidad = 10;

void setup()
{
  Serial.begin(9600);
  pinMode(buzzer, OUTPUT);
  randomSeed(analogRead(A0));

  for (int i = 0; i < cantidad; i++)
  {
    numeros[i] = random(1, 11);
  }
}

void loop()
{
  Serial.print("Numeros generados: ");
  for (int i = 0; i < cantidad; i++)
  {
    Serial.print(numeros[i]);
    Serial.print(" ");
  }
  Serial.println();

  for (int i = 0; i < cantidad; i++)
  {
    if (numeros[i] == 5)
    {
      tone(buzzer, 1000, 300);
      delay(400);
    }
  }
}
