int led1 = 8;
int led2 = 9;
int secuencia1[] = {1, 0, 0, 1, 1, 0, 1, 1};
int secuencia2[] = {0, 1, 0, 1, 0, 0, 1, 0};
int cantidad = 8;

void setup()
{
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
}

void loop()
{
  for (int i = 0; i < cantidad; i++)
  {
    digitalWrite(led1, secuencia1[i]);
    digitalWrite(led2, secuencia2[i]);
    delay(500);
  }
}
