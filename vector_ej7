int pines[] = {2, 3, 4, 5, 6};
int cantidad = 5;

void setup()
{
  for (int i = 0; i < cantidad; i++)
  {
    pinMode(pines[i], OUTPUT);
  }
}

void loop()
{
  for (int i = 0; i < cantidad; i++)
  {
    digitalWrite(pines[i], HIGH);
    delay(300);
  }
  for (int i = 0; i < cantidad; i++)
  {
    digitalWrite(pines[i], LOW);
    delay(300);
  }
    }
